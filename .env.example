# GigaChat: ключ авторизации (Base64 от client_id:client_secret) из личного кабинета
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2-Max

# DaData: источник карточки ЕГРЮЛ/ЕГРИП (в продакшене — внутренняя таблица реестра)
DADATA_TOKEN=

# Exa: веб-поиск
EXA_TOKEN=

# USE_DDG=1  # второй поисковик DuckDuckGo (0 — выключить)
